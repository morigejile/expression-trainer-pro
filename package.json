{
  "name": "expression-trainer",
  "productName": "宇宙无敌表达训练",
  "version": "1.0.1",
  "packageManager": "npm@11.19.0",
  "description": "宇宙无敌表达训练系统 - 本地桌面版",
  "main": "main.js",
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test",
    "package": "electron-forge package --platform=win32 --arch=x64",
    "make": "electron-forge make --platform=win32 --arch=x64",
    "make:internal-model": "node scripts/make-internal-model.js",
    "smoke:package": "node scripts/verify-packaged-app.js",
    "smoke:first-install": "node scripts/verify-first-install.js",
    "smoke:bundled-default": "node scripts/verify-bundled-default.js",
    "smoke:upgrade": "node scripts/verify-upgrade.js",
    "benchmark:dry-run": "node benchmark/run.js --dry-run --manifest benchmark/datasets/example/manifest.json --dataset-root benchmark/datasets/example --candidate fake",
    "spike:asr-boundary": "electron benchmark/spikes/asr-execution-boundary.js"
  },
  "keywords": [
    "expression",
    "training",
    "speech",
    "asr",
    "chinese"
  ],
  "author": "sisi",
  "license": "MIT",
  "allowScripts": {
    "electron@43.4.1": true,
    "electron-winstaller@5.4.4": true
  },
  "devDependencies": {
    "@electron-forge/cli": "7.5.0",
    "@electron-forge/maker-squirrel": "7.5.0",
    "@electron/rebuild": "3.6.0",
    "electron": "43.4.1"
  },
  "dependencies": {
    "electron-squirrel-startup": "1.0.1",
    "sherpa-onnx-node": "1.13.3"
  }
}
