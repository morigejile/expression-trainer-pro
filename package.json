{
  "name": "expression-trainer",
  "productName": "宇宙无敌表达训练",
  "version": "1.0.0",
  "packageManager": "npm@12.0.2",
  "description": "宇宙无敌表达训练系统 - 本地桌面版",
  "main": "main.js",
  "engines": {
    "node": ">=22.23.0 <23",
    "npm": ">=12.0.2 <13"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test",
    "benchmark:dry-run": "node benchmark/run.js --dry-run --manifest benchmark/datasets/example/manifest.json --dataset-root benchmark/datasets/example --candidate fake",
    "spike:asr-boundary": "electron benchmark/spikes/asr-execution-boundary.js"
  },
  "keywords": ["expression", "training", "speech", "asr", "chinese"],
  "author": "sisi",
  "license": "MIT",
  "devDependencies": {
    "electron": "43.4.1"
  },
  "dependencies": {
    "sherpa-onnx-node": "^1.10.0"
  }
}
