{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASR benchmark candidate registry",
  "type": "object",
  "required": ["candidates"],
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "displayName", "family", "mode", "sourceUrl", "upstreamVersion", "license", "sampleRateHz", "numThreads", "provider", "files"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string", "minLength": 1 },
          "family": { "type": "string", "minLength": 1 },
          "mode": { "enum": ["streaming", "utterance"] },
          "sourceUrl": { "type": "string", "format": "uri" },
          "upstreamVersion": { "type": "string", "minLength": 1 },
          "license": { "type": "object" },
          "sampleRateHz": { "type": "integer", "minimum": 1 },
          "numThreads": { "type": "integer", "minimum": 1 },
          "provider": { "type": "string", "minLength": 1 },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["relativePath", "sha256", "bytes", "role"],
              "properties": {
                "relativePath": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "bytes": { "type": "integer", "minimum": 0 },
                "role": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
