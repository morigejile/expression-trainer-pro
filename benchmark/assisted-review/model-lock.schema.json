{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sherpaVersion", "roles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sherpaVersion": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$" },
    "roles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "modelId", "modelVersion", "family", "mode", "sampleRateHz", "channels", "numThreads", "provider", "decoder", "language", "files"],
        "properties": {
          "role": { "enum": ["baseline-paraformer", "candidate-zipformer", "candidate-sensevoice-small"] },
          "modelId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$" },
          "modelVersion": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$" },
          "family": { "enum": ["paraformer", "zipformer-ctc", "sensevoice"] },
          "mode": { "enum": ["streaming", "utterance"] },
          "sampleRateHz": { "type": "integer", "minimum": 8000, "maximum": 192000 },
          "channels": { "const": 1 },
          "numThreads": { "type": "integer", "minimum": 1, "maximum": 64 },
          "provider": { "const": "cpu" },
          "decoder": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method"],
            "properties": { "method": { "const": "greedy_search" } }
          },
          "language": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value"],
            "properties": { "value": { "type": "string", "minLength": 1 } }
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["role", "relativePath", "sha256", "bytes"],
              "properties": {
                "role": { "enum": ["tokens", "encoder", "decoder", "model"] },
                "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?!.*(?:^|/)\\.\\.?/)[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$" },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "bytes": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
