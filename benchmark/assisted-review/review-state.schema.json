{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidateId", "bindingSha256", "revision", "status", "primaryTranscript", "secondaryApproval", "licenseApproval", "piiClearance", "finalTags", "lastEventSha256", "stateSha256"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "candidateId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$" },
    "bindingSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "revision": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["unreviewed", "primary-transcript-recorded", "secondary-approved", "exportable"] },
    "primaryTranscript": {
      "anyOf": [
        { "type": "null" },
        { "type": "object", "additionalProperties": false, "required": ["actorAlias", "transcriptSha256", "transcriptLength", "eventSha256"], "properties": { "actorAlias": { "$ref": "#/$defs/alias" }, "transcriptSha256": { "$ref": "#/$defs/sha256" }, "transcriptLength": { "type": "integer", "minimum": 1 }, "eventSha256": { "$ref": "#/$defs/sha256" } } }
      ]
    },
    "secondaryApproval": { "$ref": "#/$defs/simpleApproval" },
    "licenseApproval": { "$ref": "#/$defs/simpleApproval" },
    "piiClearance": { "$ref": "#/$defs/simpleApproval" },
    "finalTags": {
      "anyOf": [
        { "type": "null" },
        { "type": "object", "additionalProperties": false, "required": ["actorAlias", "tags", "lightAccentRationaleSha256", "eventSha256"], "properties": { "actorAlias": { "$ref": "#/$defs/alias" }, "tags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["mandarin", "fast", "slow", "light-accent", "code-switch", "numbers-names", "light-noise"] } }, "lightAccentRationaleSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }, "eventSha256": { "$ref": "#/$defs/sha256" } } }
      ]
    },
    "lastEventSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "stateSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "alias": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "simpleApproval": {
      "anyOf": [
        { "type": "null" },
        { "type": "object", "additionalProperties": false, "required": ["actorAlias", "eventSha256"], "properties": { "actorAlias": { "$ref": "#/$defs/alias" }, "eventSha256": { "$ref": "#/$defs/sha256" } } }
      ]
    }
  }
}
